# Copy to gate-mm.env and fill in. Keep this file private (chmod 600).
# Leave keys blank to run in dry-run only.

# ── Credentials (only needed for LIVE trading) ──
GATE_API_KEY=
GATE_API_SECRET=

# ── Safety: start in dry-run. Set to 0 ONLY when you accept real risk. ──
MM_DRY_RUN=1

# ── Strategy / universe ──
MM_MAX_SYMBOLS=8
MM_PRICE_MAX=0.01
MM_NOTIONAL_USDT=5.0

# ── Dry-run modelling ──
MM_PAPER_EQUITY=100.0
MM_START_PNL=-36

# ── Risk circuit-breakers (LIVE) ──
DAILY_LOSS_LIMIT_USDT=3.00
EQUITY_FLOOR_USDT=5.00
MAX_INVENTORY_CONTRACTS=5000

# ── Logging ──
LOG_LEVEL=INFO
MM_LOG_FILE=/var/log/gate-mm/gate_micro_mm.log
